{
  "host": "reactome.org",
  "s3_bucket": "status.reactome.org",
  "s3_prefix": "data/reactome.org",
  "aws_region": "us-east-1",
  "state_dir": "/var/lib/reactome-status",
  "interval_seconds": 300,
  "disks": [
    "/"
  ],
  "systemd_units": [
    "apache2",
    "tomcat",
    "neo4j",
    "solr",
    "mysql",
    "docker"
  ],
  "docker_containers": [],
  "http_probes": [
    {
      "name": "Website",
      "url": "https://localhost/",
      "headers": {
        "Host": "reactome.org"
      },
      "insecure": true,
      "expect_status": [
        200
      ]
    },
    {
      "name": "ContentService",
      "url": "http://localhost/ContentService/data/database/version",
      "capture_body": true
    },
    {
      "name": "AnalysisService",
      "url": "http://localhost/AnalysisService/database/version",
      "capture_body": true
    },
    {
      "name": "PathwayBrowser",
      "url": "http://localhost:8080/PathwayBrowser/"
    },
    {
      "name": "Neo4j",
      "url": "http://127.0.0.1:7474/"
    },
    {
      "name": "Chatbot",
      "url": "http://localhost:8001/chat/guest/",
      "expect_status": [
        200,
        301,
        302,
        404
      ]
    }
  ],
  "tcp_probes": [
    {
      "name": "Solr",
      "host": "127.0.0.1",
      "port": 8983
    },
    {
      "name": "MySQL",
      "host": "127.0.0.1",
      "port": 3306
    },
    {
      "name": "Neo4jBolt",
      "host": "127.0.0.1",
      "port": 7687
    },
    {
      "name": "ChatbotPostgres",
      "host": "127.0.0.1",
      "port": 5432
    }
  ],
  "service_probe": {
    "tomcat": "ContentService",
    "neo4j": "Neo4j",
    "apache2": "Website",
    "solr": "Solr",
    "mysql": "MySQL"
  },
  "apache_status_url": "http://localhost/server-status?auto",
  "access_log": {
    "path": "/usr/local/reactomes/Reactome/production/Website/apache_logs/extended_log",
    "max_bytes_per_run": 209715200,
    "groups": {
      "ContentService": "^/ContentService/",
      "AnalysisService": "^/AnalysisService/",
      "PathwayBrowser": "^/(PathwayBrowser|DiagramJs|FireworksJs)/",
      "RESTfulAPI": "^/ReactomeRESTfulAPI/",
      "Website": "^/(content/|$|index\\.php|images/|templates/|media/|modules/|plugins/|download/|icon-lib)",
      "Chatbot": "^/chat"
    }
  },
  "expected_restarts": [
    "apache2"
  ],
  "_comment_expected_restarts": "apache2 is restarted by a root cron job every 30 minutes on purpose; do not log those as events"
}
