[Unit]
Description=Reactome status collector (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=reactome-status
Group=reactome
SupplementaryGroups=adm
StateDirectory=reactome-status
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/reactome-status
ExecStart=/usr/bin/python3 /opt/reactome-status/collector.py -c /etc/reactome-status/config.json
Nice=10
IOSchedulingClass=idle
# worst case: 6 units x 20 s settling + probe timeouts + 2 x 60 s upload
TimeoutStartSec=280
# hard caps: the collector must never compete with production services
CPUQuota=50%
MemoryMax=512M
TasksMax=64
# read-only view of the system apart from its own state directory
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/reactome-status
PrivateTmp=yes
NoNewPrivileges=yes
